# ==============================================================================
# AutoBuzz — Environment Configuration Template (.env.example)
# Product: AutoBuzz | Tagline: Create. Automate. Grow.
# Repository: https://github.com/istihadahmed007/AutoBuzz
# NOTE: Never commit your real API keys, secrets, or passwords to git.
# ==============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://istihadahmed007.github.io/AutoBuzz
AUTOBUZZ_API_SECRET=your_strong_random_jwt_secret_here

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (Supabase PostgreSQL / Self-Hosted Postgres)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. AI PROVIDER INTEGRATION LAYER (Free-first / Pluggable)
# Default is configured to use free local Ollama or OpenAI-compatible endpoint.
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama # Options: ollama, openai, openrouter, anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# If using cloud providers (explicit user opt-in required):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. OFFICIAL SOCIAL MEDIA APIS (Official developer portal credentials)
# ------------------------------------------------------------------------------
# Meta Graph API (Facebook Pages & Instagram Professional)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API v3 (Shorts & Video Publishing)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. WEBSITE INTELLIGENCE & SEO (Google Search Console & Google Analytics 4)
# ------------------------------------------------------------------------------
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_CLIENT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_SITE_URL=https://example.com/

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & LEAD AUTOMATION (Resend / Brevo)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend # Options: resend, brevo, smtp
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@autobuzz.grow
EMAIL_FROM_NAME="AutoBuzz Growth"

# ------------------------------------------------------------------------------
# 6. WORKFLOW & AUTOMATION ENGINE (n8n Community or Native Queue)
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/autobuzz
N8N_API_KEY=
WORKFLOW_EXECUTION_MODE=native # Options: native, n8n
